{
  "openapi": "3.1.0",
  "info": {
    "title": "ManuQube EMS assignments",
    "version": "1.0.0",
    "description": "Site-authorized immutable app and HMI assignments. The POST command is available for isolated training fixtures. Production records require separate verified authority."
  },
  "paths": {
    "/api/ems/assignments": {
      "get": {
        "summary": "Read a page or resolve the winning assignment",
        "description": "With no target, returns assignments, targets, releases and an optional next cursor. Resolve by supplying exactly one target and the runtime kind.",
        "parameters": [
          {
            "name": "site",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Site" }
          },
          { "name": "after", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          {
            "name": "nodeId",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "terminalId",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          { "name": "kind", "in": "query", "schema": { "$ref": "#/components/schemas/AppKind" } },
          { "name": "at", "in": "query", "schema": { "$ref": "#/components/schemas/EpochMs" } }
        ],
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "Scoped page or resolution with status and exact target" },
          "400": { "description": "Invalid scope or target query" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Scope or action not granted" },
          "409": { "description": "No unique current enrollment or capacity exceeded" },
          "503": { "description": "Assignment service unavailable" }
        }
      },
      "post": {
        "summary": "Record an assignment for a published package",
        "security": [{ "session": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Assign" } } }
        },
        "responses": {
          "200": {
            "description": "Recorded or idempotently retried assignment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "string", "format": "uuid" } }
                }
              }
            }
          },
          "400": { "description": "Invalid assignment command" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Origin, scope or action not granted" },
          "404": { "description": "Published package not found within the authorized scope" },
          "409": { "description": "Target, compatibility or assignment overlap conflict" },
          "503": { "description": "Production or service gate is unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "session": { "type": "apiKey", "in": "cookie", "name": "ems_session" } },
    "schemas": {
      "Site": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
      "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$" },
      "EpochMs": { "type": "integer", "minimum": 0, "maximum": 253402214400000 },
      "AppKind": { "type": "string", "enum": ["operator", "hmi"] },
      "Assign": {
        "type": "object",
        "required": [
          "id",
          "site",
          "nodeId",
          "kind",
          "releaseId",
          "configRevision",
          "selectors",
          "effectiveFrom",
          "effectiveUntil",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "site": { "$ref": "#/components/schemas/Site" },
          "nodeId": { "$ref": "#/components/schemas/Identifier" },
          "kind": { "$ref": "#/components/schemas/AppKind" },
          "releaseId": { "type": "string", "format": "uuid" },
          "configRevision": { "$ref": "#/components/schemas/Identifier" },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["lineId", "stationId", "machineId", "operationId", "stepId", "terminalId"]
            }
          },
          "effectiveFrom": { "$ref": "#/components/schemas/EpochMs" },
          "effectiveUntil": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/components/schemas/EpochMs" }]
          },
          "reason": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    }
  }
}
